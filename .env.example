# Ollama server host (default: http://127.0.0.1:11434)
# Make sure Ollama is running: `ollama serve` or `ollama serve &`
OLLAMA_HOST=http://127.0.0.1:11434

# Model to use. Must already be pulled locally (e.g. `ollama pull llama3.2`).
# For AMD GPU: Use quantized models for better performance
#   - Small: llama3.2:1b
#   - Medium: llama3.2-vision:11b-q4_k_m
#   - Large: llama3.2:13b-q4_k_m
# For CPU or limited RAM: Use smaller models (llama3.2:1b)
# See AMD_GPU_SETUP.md if GPU not detected
OLLAMA_MODEL=llama3.2

# System prompt prepended to every conversation.
SYSTEM_PROMPT="You are a helpful, concise assistant replying inside a WhatsApp chat. Keep answers short, friendly, and use plain text only (no markdown). Reply in the same language the user wrote in."

# venom-bot session name (creates a tokens folder under this name).
SESSION_NAME=ollama-wa

# Respond inside group chats. Set to "true" to also reply in groups.
REPLY_IN_GROUPS=false

# Only reply in groups when the bot is mentioned (@<bot>). Ignored when REPLY_IN_GROUPS=false.
REPLY_ONLY_ON_MENTION=true

# Maximum messages of history (per chat) to send back to the model.
HISTORY_LIMIT=20

# Show a "typing..." presence in the chat while generating.
SEND_TYPING=true

# Rate limit in milliseconds (per chat). Skip reply if under this interval from last reply.
RATE_LIMIT_MS=1000

# Persist conversation history to disk (survives bot restarts).
PERSIST_HISTORY=true

# Directory for persistent storage (created if missing).
STORAGE_DIR=./data

# Allow `/model`, `/temp`, `/creative`, `/precise` commands. Set to "false" to lock model/temp.
ALLOW_MODEL_SWITCH=true

# Default temperature for model responses (0=deterministic, 1=very creative).
DEFAULT_TEMPERATURE=0.7

# Comma-separated list of chat IDs to ignore (e.g. "5215551234567@c.us,1203630@g.us").
IGNORE_CHATS=

# Comma-separated allowlist. When set, only these chat IDs get replies. Leave empty to allow all.
ALLOW_CHATS=
